{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/[coupleSlug]/arrival/check-password",
      "regex": "^/api/([^/]+?)/arrival/check\\-password(?:/)?$",
      "routeKeys": {
        "nxtPcoupleSlug": "nxtPcoupleSlug"
      },
      "namedRegex": "^/api/(?<nxtPcoupleSlug>[^/]+?)/arrival/check\\-password(?:/)?$"
    },
    {
      "page": "/api/[coupleSlug]/arrival/register",
      "regex": "^/api/([^/]+?)/arrival/register(?:/)?$",
      "routeKeys": {
        "nxtPcoupleSlug": "nxtPcoupleSlug"
      },
      "namedRegex": "^/api/(?<nxtPcoupleSlug>[^/]+?)/arrival/register(?:/)?$"
    },
    {
      "page": "/api/[coupleSlug]/checkout-list",
      "regex": "^/api/([^/]+?)/checkout\\-list(?:/)?$",
      "routeKeys": {
        "nxtPcoupleSlug": "nxtPcoupleSlug"
      },
      "namedRegex": "^/api/(?<nxtPcoupleSlug>[^/]+?)/checkout\\-list(?:/)?$"
    },
    {
      "page": "/api/[coupleSlug]/confirm",
      "regex": "^/api/([^/]+?)/confirm(?:/)?$",
      "routeKeys": {
        "nxtPcoupleSlug": "nxtPcoupleSlug"
      },
      "namedRegex": "^/api/(?<nxtPcoupleSlug>[^/]+?)/confirm(?:/)?$"
    },
    {
      "page": "/api/[coupleSlug]/invitation/[uuid]",
      "regex": "^/api/([^/]+?)/invitation/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcoupleSlug": "nxtPcoupleSlug",
        "nxtPuuid": "nxtPuuid"
      },
      "namedRegex": "^/api/(?<nxtPcoupleSlug>[^/]+?)/invitation/(?<nxtPuuid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/[coupleSlug]/table",
      "regex": "^/api/([^/]+?)/table(?:/)?$",
      "routeKeys": {
        "nxtPcoupleSlug": "nxtPcoupleSlug"
      },
      "namedRegex": "^/api/(?<nxtPcoupleSlug>[^/]+?)/table(?:/)?$"
    },
    {
      "page": "/[coupleSlug]/arrival/[uuid]",
      "regex": "^/([^/]+?)/arrival/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcoupleSlug": "nxtPcoupleSlug",
        "nxtPuuid": "nxtPuuid"
      },
      "namedRegex": "^/(?<nxtPcoupleSlug>[^/]+?)/arrival/(?<nxtPuuid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[coupleSlug]/checkout_list",
      "regex": "^/([^/]+?)/checkout_list(?:/)?$",
      "routeKeys": {
        "nxtPcoupleSlug": "nxtPcoupleSlug"
      },
      "namedRegex": "^/(?<nxtPcoupleSlug>[^/]+?)/checkout_list(?:/)?$"
    },
    {
      "page": "/[coupleSlug]/table",
      "regex": "^/([^/]+?)/table(?:/)?$",
      "routeKeys": {
        "nxtPcoupleSlug": "nxtPcoupleSlug"
      },
      "namedRegex": "^/(?<nxtPcoupleSlug>[^/]+?)/table(?:/)?$"
    },
    {
      "page": "/[coupleSlug]/view_pass/[uuid]",
      "regex": "^/([^/]+?)/view_pass/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcoupleSlug": "nxtPcoupleSlug",
        "nxtPuuid": "nxtPuuid"
      },
      "namedRegex": "^/(?<nxtPcoupleSlug>[^/]+?)/view_pass/(?<nxtPuuid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[coupleSlug]/[uuid]",
      "regex": "^/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcoupleSlug": "nxtPcoupleSlug",
        "nxtPuuid": "nxtPuuid"
      },
      "namedRegex": "^/(?<nxtPcoupleSlug>[^/]+?)/(?<nxtPuuid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[coupleSlug]/[uuid]/confirm",
      "regex": "^/([^/]+?)/([^/]+?)/confirm(?:/)?$",
      "routeKeys": {
        "nxtPcoupleSlug": "nxtPcoupleSlug",
        "nxtPuuid": "nxtPuuid"
      },
      "namedRegex": "^/(?<nxtPcoupleSlug>[^/]+?)/(?<nxtPuuid>[^/]+?)/confirm(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}